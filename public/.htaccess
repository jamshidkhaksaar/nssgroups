Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Public React routes can share names with static asset directories.
  # Route exact application paths first, then allow real files and directories.
  RewriteRule ^(?:about|company-portfolio|services|fleet|network|contact|trading|marketplace|booking|projects|tracking|portal|admin|client-portal|partner-portal|login(?:/(?:admin|client|partner))?|register)/?$ index.html [L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
