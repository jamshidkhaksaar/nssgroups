Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.nssgroupint\.com$ [NC]
  RewriteRule ^ https://nssgroupint.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://nssgroupint.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^trading/?$ /marketplace [R=301,L,NC]

  # RFQ links carry form-prefill parameters and are not standalone search
  # destinations. Keep /contact as the canonical page and explicitly signal
  # crawlers not to index these query variants.
  RewriteCond %{QUERY_STRING} (^|&)intent=procurement(&|$) [NC]
  RewriteRule ^contact/?$ - [E=RFQ_NOINDEX:1]

  # Serve a prerendered per-route document when one exists (built by
  # scripts/inject-route-meta.mjs) so social/link scrapers that don't run JS
  # still get route-specific title/description/OG tags. Falls through otherwise.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Public React routes can share names with static asset directories.
  # Route exact application paths first, then allow real files and directories.
  RewriteRule ^(?:about|company-portfolio|services|fleet|network|contact|marketplace(?:/product/[A-Za-z0-9-]+)?|booking|projects|tracking|portal|admin|client-portal|partner-portal|login(?:/(?:admin|client|partner))?|register)/?$ index.html [L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml application/rss+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff
</IfModule>

# ── Caching ──
<IfModule mod_expires.c>
  ExpiresActive On
  # Fingerprinted build assets — safe to cache aggressively.
  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images/media — long but not immutable (filenames aren't always hashed).
  <FilesMatch "\.(jpe?g|png|gif|webp|avif|svg|ico|mp4|webm)$">
    ExpiresDefault "access plus 30 days"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate the app shell and route documents so deploys take effect.
  <FilesMatch "(^index\.html|/index\.html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header set X-Robots-Tag "noindex, follow" env=RFQ_NOINDEX
</IfModule>
